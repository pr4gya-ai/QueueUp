# Server
PORT=3000
# Frontend origin, used for the OAuth redirect back to /accounts
CLIENT_URL=http://localhost:5173

# Required
MONGODB_URL=mongodb://localhost:27017/social-media-automation
JWT_SECRET=change-me-to-a-long-random-string

# Zernio: connecting accounts and publishing posts
ZERNIO_API_KEY=
# ZERNIO_BASE_URL=https://api.zernio.com

# Google Gemini: AI post generation
GEMINI_API_KEY=
# Optional override if the default model is retired or unavailable to your project
# GEMINI_MODEL=gemini-3.5-flash

# Hugging Face: AI image generation
HUGGINGFACE_API_KEY=

# Cloudinary: media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
