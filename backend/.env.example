# Server
PORT=3000
# Frontend origin, used for the OAuth redirect back to /accounts
CLIENT_URL="http://localhost:5173"

# Required
MONGODB_URL=mongodb://localhost:27017/social-media-automation
JWT_SECRET=change-me-to-a-long-random-string

# Zernio: connecting accounts and publishing posts
ZERNIO_API_KEY=
# Leave ZERNIO_BASE_URL unset: the SDK default (https://zernio.com/api) is correct.
# Only set it if Zernio tells you to use a different API root.
# ZERNIO_BASE_URL=

# Google Gemini: AI post generation
GEMINI_API_KEY=
# Optional: preferred model. If it is retired/unavailable (404) the server automatically
# falls back to gemini-3.8-flash, gemini-3.5-flash, then gemini-2.5-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Hugging Face: AI image generation
HUGGINGFACE_API_KEY=

# Cloudinary: media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
POLLINATIONS_DISABLED=""